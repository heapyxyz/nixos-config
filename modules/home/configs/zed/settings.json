{
  "ensure_final_newline_on_save": false,
  "show_edit_predictions": false,
  "prettier": {
    "allowed": true,
    "semi": false,
    "trailingComma": "none"
  },
  "languages": {
    "CSharp": {
      "formatter": "language_server",
      "tab_size": 4
    },
    "C": {
      "formatter": "language_server",
      "tab_size": 4
    },
    "C++": {
      "formatter": "language_server",
      "tab_size": 4
    },
    "Python": {
      "formatter": "language_server",
      "tab_size": 4
    },
    "JavaScript": {
      "formatter": "prettier",
      "tab_size": 2
    },
    "TypeScript": {
      "formatter": "prettier",
      "tab_size": 2
    },
    "TSX": {
      "formatter": "prettier",
      "tab_size": 2
    },
    "JSON": {
      "formatter": "prettier",
      "tab_size": 2
    },
    "CSS": {
      "formatter": "prettier",
      "tab_size": 2
    },
    "HTML": {
      "formatter": "prettier",
      "tab_size": 4
    },
    "XML": {
      "formatter": "language_server",
      "tab_size": 4
    },
    "TOML": {
      "formatter": "prettier",
      "tab_size": 4
    },
    "YAML": {
      "formatter": "prettier",
      "tab_size": 2
    },
    "Nix": {
      "formatter": "language_server",
      "tab_size": 2
    },
    "Prisma": {
      "formatter": "language_server",
      "tab_size": 2
    }
  },
  "auto_install_extensions": {
    "assembly": true,
    "codebook": true,
    "comment": true,
    "csharp": true,
    "dockerfile": true,
    "env": true,
    "git-firefly": true,
    "html": true,
    "ini": true,
    "json5": true,
    "latex": true,
    "log": true,
    "ltex": true,
    "macos-classic": true,
    "make": true,
    "neocmake": true,
    "nix": true,
    "prisma": true,
    "rainbow-csv": true,
    "sql": true,
    "toml": true,
    "vscode-icons": true,
    "xml": true
  },
  "agent": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left"
  },
  "format_on_save": "on",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font"
  },
  "node": {
    "npm_path": "pnpm"
  },
  "minimap": {
    "show": "always"
  },
  "autosave": "on_focus_change",
  "buffer_font_fallbacks": ["JetBrainsMono Nerd Font"],
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "file_types": {
    "tailwindcss": ["*.css"],
    "jsonc": ["*.json"]
  },
  "auto_indent_on_paste": true,
  "soft_wrap": "editor_width",
  "icon_theme": "VSCode Icons for Zed (Dark)",
  "theme": "macOS Classic Dark",
  "base_keymap": "VSCode"
}
